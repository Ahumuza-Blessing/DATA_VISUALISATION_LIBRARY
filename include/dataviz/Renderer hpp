

#ifndef DATAVIZ_RENDERER_HPP
#define DATAVIZ_RENDERER_HPP

#include <string>
#include <vector>

namespace dataviz {

struct Point {
    double x;
    double y;
};

struct Plot {
    std::string title;
    std::string x_label;
    std::string y_label;
    std::vector<Point> points;
};

class Renderer {
public:
    // Render a plot as SVG text.
    std::string render_svg(const Plot& plot) const;

    // Save the SVG representation to a file.
    bool save_svg(const Plot& plot,
                  const std::string& filename) const;
};

} // namespace dataviz

#endif // DATAVIZ_RENDERER_HPP
